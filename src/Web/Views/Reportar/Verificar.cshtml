@{
    ViewData["Title"] = "Verificar reporte";
    var codigoSeguimiento = ViewBag.CodigoSeguimiento as string;
}

<div class="max-w-lg mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-primary mb-2">Verificar reporte</h1>
    <p class="text-neutral-600 mb-8">Ingresa el código de seguimiento y el código de verificación que recibiste por SMS o correo electrónico.</p>

    <form method="post" action="/Reportar/Verificar" class="bg-white p-6 rounded-lg shadow-sm border border-neutral-200 space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-semibold mb-1" for="codigoSeguimiento">Código de seguimiento</label>
            <input type="text" id="codigoSeguimiento" name="codigoSeguimiento" value="@codigoSeguimiento" required
                   class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary" />
        </div>

        <div>
            <label class="block text-sm font-semibold mb-1" for="codigoVerificacion">Código de verificación</label>
            <input type="text" id="codigoVerificacion" name="codigoVerificacion" required
                   class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary" />
        </div>

        <div class="flex justify-end">
            <button type="submit" class="px-8 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary-light transition min-h-[44px]">Verificar</button>
        </div>
    </form>

    @if (TempData["Mensaje"] != null)
    {
        <div class="mt-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg">@TempData["Mensaje"]</div>
    }
</div>
